{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:int": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "APP_ENV",
        "DATABASE_URL",
        "DATABASE_PLATFORM_URL",
        "DATABASE_MIGRATION_URL"
      ]
    },
    "dev:mocks": {
      "cache": false,
      "persistent": true
    }
  }
}
