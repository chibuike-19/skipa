{
  "name": "skipa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "commitlint": "commitlint",
    "local:env": "pnpm --filter @skipa/api local:env",
    "db:up": "docker compose -f infra/compose/dev.yaml up -d --wait postgres",
    "db:down": "docker compose -f infra/compose/dev.yaml down",
    "db:migrate": "pnpm --filter @skipa/api db:migrate",
    "test:int": "turbo run test:int",
    "local:setup": "pnpm local:env && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "contract:build": "pnpm --filter @skipa/contracts contract:build",
    "contract:check": "pnpm --filter @skipa/contracts contract:check",
    "db:seed": "pnpm --filter @skipa/api db:seed",
    "mocks:validate": "pnpm --filter @skipa/mocks mocks:validate",
    "api-client:gen": "pnpm --filter @skipa/api-client api-client:gen",
    "tokens:build": "pnpm --filter @skipa/tokens build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@skipa/config": "workspace:*",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
