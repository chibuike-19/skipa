# Names only (brief §17). No secrets in frontend env: the Paystack public key arrives with the
# payment attempt, and the GlitchTip DSN is public by design.
VITE_APP=shopper
VITE_API_URL=http://localhost:4000
VITE_USE_MOCKS=true
# Comma list of OpenAPI tags served by the real API while mocks are on, e.g. System,Shopping
VITE_MOCK_LIVE_TAGS=
VITE_RELEASE=
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=
VITE_CANVAS_URL=https://claude.ai/artifact/YQNrXAXnjqDJ521Ji6zHJH
