{
  "name": "@skipa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:env": "node scripts/local-env.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts"
  },
  "description": "Fastify HTTP API (src/server.ts) and pg-boss worker (src/worker.ts).",
  "dependencies": {
    "@fastify/rate-limit": "11.3.0",
    "@sentry/node": "11.17.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7",
    "@skipa/contracts": "workspace:*",
    "@skipa/domain": "workspace:*"
  },
  "devDependencies": {
    "@skipa/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
